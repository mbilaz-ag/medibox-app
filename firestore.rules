rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email in [
          'andrius.grudinskas@gmail.com',
          'mbilaz@gmail.com'
        ];
    }
    function isDeleted(userId) {
      return exists(/databases/$(database)/documents/deletedUsers/$(userId));
    }
    function household(id) {
      return get(/databases/$(database)/documents/households/$(id)).data;
    }
    function isHouseholdMember(id) {
      return signedIn() && request.auth.uid in household(id).memberUids;
    }
    function validJoin(id) {
      return signedIn()
        && !isDeleted(request.auth.uid)
        && !(request.auth.uid in resource.data.memberUids)
        && request.auth.uid in request.resource.data.memberUids
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'accounts'])
        && request.resource.data.inviteCode == resource.data.inviteCode
        && get(/databases/$(database)/documents/householdInvites/$(resource.data.inviteCode)).data.active == true
        && get(/databases/$(database)/documents/householdInvites/$(resource.data.inviteCode)).data.householdId == id
        && get(/databases/$(database)/documents/householdInvites/$(resource.data.inviteCode)).data.ownerUid == resource.data.ownerUid;
    }
    function validLeave() {
      return signedIn()
        && request.auth.uid in resource.data.memberUids
        && !(request.auth.uid in request.resource.data.memberUids)
        && resource.data.ownerUid != request.auth.uid
        && request.resource.data.memberUids.size() == resource.data.memberUids.size() - 1
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids', 'accounts']);
    }

    match /users/{userId}/medibox/{document} {
      allow read, write: if isAdmin()
        || (signedIn() && request.auth.uid == userId && !isDeleted(userId));
    }
    match /users/{userId}/settings/{document} {
      allow read, write: if isAdmin()
        || (signedIn() && request.auth.uid == userId && !isDeleted(userId));
    }
    match /users/{userId}/subscription/{document} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == userId && !isDeleted(userId));
      allow write: if isAdmin();
    }
    match /userProfiles/{userId} {
      allow read: if signedIn()
        && (request.auth.uid == userId || isAdmin());
      allow create: if signedIn()
        && request.auth.uid == userId
        && !isDeleted(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly([
          'uid', 'email', 'displayName', 'photoUrl', 'isAnonymous',
          'providers', 'createdAt', 'lastSeenAt'
        ]);
      allow update: if signedIn()
        && request.auth.uid == userId
        && !isDeleted(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email', 'displayName', 'photoUrl', 'isAnonymous',
          'providers', 'lastSeenAt'
        ]);
      allow delete: if isAdmin();
    }
    match /premiumRequests/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && !isDeleted(userId)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read, update: if isAdmin();
      allow delete: if isAdmin();
    }
    match /deletedUsers/{userId} {
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == userId);
      allow create, update, delete: if isAdmin();
    }
    match /households/{householdpk} {
      allow create: if signedIn()
                    && !isDeleted(request.auth.uid)
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.auth.uid in request.resource.data.memberUids;
      allow read: if isAdmin()
                  || (signedIn() && request.auth.uid in resource.data.memberUids);
      allow update: if (signedIn() && resource.data.ownerUid == request.auth.uid)
                    || isAdmin()
                    || validJoin(householdpk)
                    || validLeave();
      allow delete: if isAdmin()
                    || (signedIn() && resource.data.ownerUid == request.auth.uid);
      match /data/{document} {
        allow read, write: if isAdmin() || isHouseholdMember(householdpk);
      }
    }
    match /householdInvites/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
                    && request.resource.data.ownerUid == request.auth.uid
                    && get(/databases/$(database)/documents/households/$(request.resource.data.householdId)).data.ownerUid == request.auth.uid;
      allow update, delete: if isAdmin()
                            || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }
  }
}
